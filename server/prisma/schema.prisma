// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  email    String @unique
  password String

  trialStartedAt DateTime?
  trialEndsAt    DateTime?

  shops        Shop[]
  memberships  ShopMember[]
  subscription Subscription[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shop {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid

  name        String
  address     String?
  gst         String?
  phoneNumber String?

  owner User @relation(fields: [ownerId], references: [id])

  members   ShopMember[]
  customers Customer[]
  devices   InventoryDevice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  planId String @db.Uuid

  status SubscriptionStatus

  startsAt DateTime
  endsAt   DateTime

  cancelledAt DateTime?

  user User @relation(fields: [userId], references: [id])

  plan Plan @relation(fields: [planId], references: [id])

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Plan {
  id String @id @default(uuid()) @db.Uuid

  name String
  code PlanCode @unique

  price       Decimal @db.Decimal(10, 2)
  billingDays Int

  maxShops   Int
  maxMembers Int

  subscriptions Subscription[]
  payments      Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  userId         String  @db.Uuid
  subscriptionId String? @db.Uuid
  planId         String  @db.Uuid

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  status PaymentStatus

  razorpayPaymentId String? @unique
  razorpayOrderId   String? @unique
  razorpaySignature String?

  paidAt DateTime?

  user User @relation(fields: [userId], references: [id])

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  plan Plan @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subscriptionId])
}

model RazorpayWebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  eventId   String @unique
  eventType String

  processedAt DateTime?

  createdAt DateTime @default(now())
}

model ShopMember {
  userId String @db.Uuid
  shopId String @db.Uuid

  role ShopRole

  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([userId, shopId])
  @@index([shopId])
}

model Customer {
  id     String @id @default(uuid()) @db.Uuid
  shopId String @db.Uuid

  name         String
  aadharNumber String
  phoneNumber  String?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  dealsAsSeller InventoryDevice[] @relation("Seller")
  dealsAsBuyer  InventoryDevice[] @relation("Buyer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, aadharNumber])
  @@index([shopId])
  @@index([phoneNumber])
}

model InventoryDevice {
  id     String @id @default(uuid()) @db.Uuid
  shopId String @db.Uuid

  brandId Int

  name   String
  colour String

  imei1 String
  imei2 String?

  storage Int?
  ram     Int?

  sellerId String  @db.Uuid
  buyerId  String? @db.Uuid

  buyPrice  Decimal  @db.Decimal(10, 2)
  sellPrice Decimal? @db.Decimal(10, 2)

  buyDate  DateTime
  sellDate DateTime?

  status InventoryStatus @default(IN_STOCK)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  brand Brand @relation(fields: [brandId], references: [id])

  seller Customer @relation("Seller", fields: [sellerId], references: [id])

  buyer Customer? @relation("Buyer", fields: [buyerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([sellerId])
  @@index([buyerId])
}

model Brand {
  id Int @id @default(autoincrement())

  name String @unique

  devices InventoryDevice[]
}

model VerificationRequest {
  id String @id @default(uuid()) @db.Uuid

  name         String?
  email        String
  passwordHash String?

  otpHash String

  resendAvailableAt DateTime
  expiresAt         DateTime
  verifiedAt        DateTime?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

enum PlanCode {
  FREE
  BASIC_MONTHLY
  BASIC_YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ShopRole {
  OWNER
  MANAGER
  EMPLOYEE
}

enum InventoryStatus {
  IN_STOCK
  SOLD
}
